<configuration>
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} [%X{app_trace_id}] %-5level %logger{36} - %msg%n"/>
    <springProperty name="LOG_DIR"   source="app.logging.dir"  defaultValue="logs"/>
    <springProperty name="APP_LEVEL" source="app.logging.level.app"  defaultValue="DEBUG"/>
    <springProperty name="ROOT_LEVEL" source="app.logging.level.root" defaultValue="INFO"/>
    <springProperty name="AUDIT_LEVEL" source="app.logging.level.audit" defaultValue="INFO"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/expense-tracker.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/expense-tracker-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/audit-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{app_trace_id}] %msg%n</pattern></encoder>
    </appender>

    <logger name="AUDIT" level="${AUDIT_LEVEL}" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <logger name="com.ksportfolio.expensetracker" level="${APP_LEVEL}"/>

    <root level="${ROOT_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>